# Keep this file as a template only. Put real values in your deployment host's secrets/settings.
SECRET_KEY=replace-with-a-long-random-secret
APP_TIMEZONE=Asia/Kolkata

# SMTP provider configuration (example values only)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-real-email@example.com
MAIL_PASSWORD=your-email-app-password
MAIL_FROM=ExamFlow <your-real-email@example.com>
MAIL_USE_TLS=true

# Use one web worker when the built-in reminder scheduler is enabled.
START_SCHEDULER=true
TEACHER_INVITE_CODE=create-a-private-teacher-invite-code
